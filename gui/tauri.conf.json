{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Miti",
  "version": "0.1.0",
  "identifier": "org.miti.gui",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Miti", "width": 440, "height": 680, "resizable": false }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
